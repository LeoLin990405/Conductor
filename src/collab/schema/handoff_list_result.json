{
  "$id": "https://conductor.local/collab/schema/handoff_list_result.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "handoffs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "expires_at": {
            "format": "date-time",
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "handoff_id": {
            "type": "string"
          },
          "note": {
            "maxLength": 1000,
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        },
        "required": [
          "handoff_id",
          "state"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "handoffs"
  ],
  "title": "collab.handoff_list_result",
  "type": "object"
}
