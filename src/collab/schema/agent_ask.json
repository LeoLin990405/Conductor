{
  "$id": "https://conductor.local/collab/schema/agent_ask.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "about": {
      "maxLength": 200,
      "pattern": "^(^t:[0-9a-f-]{36}$|^d:[A-Za-z0-9_-]{1,64}:[A-Za-z0-9_-]{1,64}$)$",
      "type": "string"
    },
    "reply_to": {
      "type": "string"
    },
    "text": {
      "maxLength": 2000,
      "minLength": 1,
      "type": "string"
    },
    "to": {
      "description": "app:<app_id>, or t:<ticket_uuid>",
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "to",
    "text"
  ],
  "title": "agent_ask_input",
  "type": "object"
}
