{
  "$id": "https://conductor.local/collab/schema/review_list_result.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "reviews": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "author": {
            "type": "string"
          },
          "commit": {
            "pattern": "^[0-9a-f]{7,40}$",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "focus": {
            "maxLength": 1000,
            "type": "string"
          },
          "review_id": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "target_ref": {
            "maxLength": 200,
            "pattern": "^(^t:[0-9a-f-]{36}$|^d:[A-Za-z0-9_-]{1,64}:[A-Za-z0-9_-]{1,64}$)$",
            "type": "string"
          }
        },
        "required": [
          "review_id",
          "target_ref",
          "author",
          "commit",
          "state"
        ],
        "title": "review_view",
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "reviews"
  ],
  "title": "collab.review_list_result",
  "type": "object"
}
