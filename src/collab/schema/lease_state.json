{
  "$id": "https://conductor.local/collab/schema/lease_state.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "heartbeat_at": {
      "format": "date-time",
      "type": "string"
    },
    "lease_id": {
      "type": "string"
    },
    "ref": {
      "maxLength": 200,
      "pattern": "^(^t:[0-9a-f-]{36}$|^d:[A-Za-z0-9_-]{1,64}:[A-Za-z0-9_-]{1,64}$)$",
      "type": "string"
    },
    "state": {
      "type": "string"
    }
  },
  "required": [
    "lease_id",
    "state"
  ],
  "title": "lease_state",
  "type": "object"
}
