{
  "$id": "https://conductor.local/collab/schema/message_result.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "message": {
      "additionalProperties": false,
      "properties": {
        "about": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "sent_at": {
          "format": "date-time",
          "type": "string"
        },
        "text": {
          "maxLength": 2000,
          "type": "string"
        },
        "untrusted": {
          "const": true
        }
      },
      "required": [
        "id",
        "from",
        "text",
        "sent_at",
        "untrusted"
      ],
      "title": "message_view",
      "type": "object"
    }
  },
  "required": [
    "message"
  ],
  "title": "collab.message_result",
  "type": "object"
}
