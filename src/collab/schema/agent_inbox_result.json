{
  "$id": "https://conductor.local/collab/schema/agent_inbox_result.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "messages": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "about": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "sent_at": {
            "format": "date-time",
            "type": "string"
          },
          "text": {
            "maxLength": 2000,
            "type": "string"
          },
          "untrusted": {
            "const": true
          }
        },
        "required": [
          "id",
          "from",
          "text",
          "sent_at",
          "untrusted"
        ],
        "title": "message_view",
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "messages"
  ],
  "title": "collab.agent_inbox_result",
  "type": "object"
}
