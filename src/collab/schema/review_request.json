{
  "$id": "https://conductor.local/collab/schema/review_request.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "commit": {
      "pattern": "^[0-9a-f]{7,40}$",
      "type": "string"
    },
    "focus": {
      "maxLength": 1000,
      "type": "string"
    },
    "force": {
      "default": false,
      "description": "create a new review even when a pending or completed review of the same commit and reviewer exists (dedup enforce mode)",
      "type": "boolean"
    },
    "lease_id": {
      "type": "string"
    },
    "reviewer": {
      "default": "native",
      "description": "app:<app_id>, 'native' or 'any'",
      "type": "string"
    }
  },
  "required": [
    "lease_id",
    "commit"
  ],
  "title": "review_request_input",
  "type": "object"
}
