{
  "$id": "https://conductor.local/collab/schema/task_claim_result.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "heartbeat_every_seconds": {
      "type": "integer"
    },
    "lease_id": {
      "type": "string"
    },
    "max_lease_until": {
      "format": "date-time",
      "type": "string"
    },
    "ref": {
      "maxLength": 200,
      "pattern": "^(^t:[0-9a-f-]{36}$|^d:[A-Za-z0-9_-]{1,64}:[A-Za-z0-9_-]{1,64}$)$",
      "type": "string"
    },
    "rules": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "worktree": {
      "additionalProperties": false,
      "properties": {
        "base_sha": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "branch",
        "base_sha"
      ],
      "title": "worktree",
      "type": "object"
    }
  },
  "required": [
    "lease_id",
    "ref",
    "expires_at",
    "worktree"
  ],
  "title": "task_claim_result",
  "type": "object"
}
