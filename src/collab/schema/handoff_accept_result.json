{
  "$id": "https://conductor.local/collab/schema/handoff_accept_result.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "heartbeat_every_seconds": {
      "minimum": 1,
      "type": "integer"
    },
    "lease_id": {
      "type": "string"
    },
    "pack": {
      "additionalProperties": false,
      "properties": {
        "conversation_ref": {
          "additionalProperties": false,
          "properties": {
            "app": {
              "type": "string"
            },
            "session_id": {
              "maxLength": 200,
              "type": "string"
            }
          },
          "required": [
            "app",
            "session_id"
          ],
          "title": "conversation_ref",
          "type": "object"
        },
        "system": {
          "additionalProperties": false,
          "properties": {
            "commits": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "from": {
              "type": "string"
            },
            "gate_results": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "at": {
                    "format": "date-time",
                    "type": "string"
                  },
                  "gate": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  },
                  "result": {
                    "type": "string"
                  }
                },
                "title": "gate_result",
                "type": "object"
              },
              "type": "array"
            },
            "last_report": {
              "additionalProperties": false,
              "properties": {
                "artifacts": {
                  "additionalProperties": false,
                  "properties": {
                    "commits": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "files": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "pr": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "commits",
                    "files",
                    "pr"
                  ],
                  "title": "completion_artifacts",
                  "type": "object"
                },
                "handbacks": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "next": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "done",
                    "partial",
                    "blocked",
                    "needs_review",
                    "needs_split"
                  ]
                },
                "summary": {
                  "type": "string"
                },
                "verification": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "ran": {
                        "type": "string"
                      },
                      "result": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "ran",
                      "result"
                    ],
                    "title": "completion_verification",
                    "type": "object"
                  },
                  "type": "array"
                }
              },
              "required": [
                "status",
                "summary",
                "artifacts",
                "verification",
                "next",
                "handbacks"
              ],
              "title": "completion_report",
              "type": "object"
            },
            "open_findings": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "reason": {
              "type": "string"
            },
            "task": {
              "additionalProperties": false,
              "properties": {
                "acceptance": {
                  "items": {
                    "maxLength": 500,
                    "type": "string"
                  },
                  "maxItems": 20,
                  "type": "array"
                },
                "body": {
                  "maxLength": 8000,
                  "type": "string"
                },
                "claim_refusal": {
                  "type": "string"
                },
                "claimable": {
                  "type": "boolean"
                },
                "kind": {
                  "enum": [
                    "ticket",
                    "line"
                  ]
                },
                "owner": {
                  "additionalProperties": false,
                  "properties": {
                    "deadline": {
                      "format": "date-time",
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string"
                    }
                  },
                  "title": "owner",
                  "type": "object"
                },
                "ref": {
                  "maxLength": 200,
                  "pattern": "^(^t:[0-9a-f-]{36}$|^d:[A-Za-z0-9_-]{1,64}:[A-Za-z0-9_-]{1,64}$)$",
                  "type": "string"
                },
                "repo": {
                  "maxLength": 200,
                  "type": "string"
                },
                "revision": {
                  "type": "integer"
                },
                "risk_bearing": {
                  "type": "boolean"
                },
                "status": {
                  "type": "string"
                },
                "title": {
                  "maxLength": 200,
                  "type": "string"
                },
                "write_scope": {
                  "items": {
                    "maxLength": 200,
                    "type": "string"
                  },
                  "maxItems": 50,
                  "type": "array"
                }
              },
              "required": [
                "ref",
                "kind",
                "title",
                "status",
                "claimable",
                "revision"
              ],
              "title": "task_view",
              "type": "object"
            }
          },
          "title": "handoff_system",
          "type": "object"
        },
        "worker_reported": {
          "additionalProperties": false,
          "properties": {
            "done": {
              "items": {
                "maxLength": 200,
                "type": "string"
              },
              "maxItems": 10,
              "type": "array"
            },
            "in_progress": {
              "items": {
                "maxLength": 200,
                "type": "string"
              },
              "maxItems": 10,
              "type": "array"
            },
            "next": {
              "items": {
                "maxLength": 200,
                "type": "string"
              },
              "maxItems": 10,
              "type": "array"
            },
            "open_questions": {
              "items": {
                "maxLength": 200,
                "type": "string"
              },
              "maxItems": 10,
              "type": "array"
            },
            "pitfalls": {
              "items": {
                "maxLength": 200,
                "type": "string"
              },
              "maxItems": 10,
              "type": "array"
            }
          },
          "title": "self_report",
          "type": "object"
        },
        "worktree": {
          "additionalProperties": false,
          "properties": {
            "base_sha": {
              "type": "string"
            },
            "branch": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path",
            "branch",
            "base_sha"
          ],
          "title": "worktree",
          "type": "object"
        }
      },
      "required": [
        "system",
        "worktree"
      ],
      "title": "handoff_pack",
      "type": "object"
    }
  },
  "required": [
    "lease_id",
    "heartbeat_every_seconds",
    "pack"
  ],
  "title": "collab.handoff_accept_result",
  "type": "object"
}
