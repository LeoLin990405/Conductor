{
  "$id": "https://conductor.local/collab/schema/task_claim.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent": {
      "maxLength": 64,
      "type": "string"
    },
    "lease_seconds": {
      "default": 900,
      "maximum": 3600,
      "minimum": 300,
      "type": "integer"
    },
    "ref": {
      "maxLength": 200,
      "pattern": "^(^t:[0-9a-f-]{36}$|^d:[A-Za-z0-9_-]{1,64}:[A-Za-z0-9_-]{1,64}$)$",
      "type": "string"
    },
    "revision": {
      "type": "integer"
    }
  },
  "required": [
    "ref",
    "revision"
  ],
  "title": "task_claim_input",
  "type": "object"
}
