<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>__LABEL__</string>
  <key>ProgramArguments</key><array>
    <string>__PYTHON__</string>
    <string>-m</string>
    <string>src.conductor_cli.ops_cli</string>
    <string>up</string>
    <string>--foreground</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>EnvironmentVariables</key><dict>
    <key>CONDUCTOR_REPO_ROOT</key><string>__REPO__</string>
    <key>CONDUCTOR_HOME</key><string>__HOME__</string>
    <key>CONDUCTOR_BACKEND_PORT</key><string>__BACKEND_PORT__</string>
    <key>CONDUCTOR_WEB_PORT</key><string>__WEB_PORT__</string>
    <key>CONDUCTOR_SECRETS_FILE</key><string>__SECRETS__</string>
    <key>CONDUCTOR_WORKTREE_ROOT</key><string>__WORKTREE_ROOT__</string>
    <key>PYTHONPATH</key><string>__REPO__</string>
  </dict>
  <key>RunAtLoad</key>__RUN_AT_LOAD__
  <key>KeepAlive</key>__KEEP_ALIVE__
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>__LOG__</string>
  <key>StandardErrorPath</key><string>__LOG__</string>
</dict></plist>
