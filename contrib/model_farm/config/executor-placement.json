        "m4"
      ],
      "binding": "candidate_only",
      "enabled": true,
      "host_status": {
        "m4": "verified_ready"
      },
      "verification": "example_ollama-m4-guarded_runtime_check_record"
    },
    "qwen": {
      "hosts": [
        "m4",
        "m720q-b"
      ],
      "binding": "candidate_only",
      "enabled": false,
      "host_status": {
        "m4": "auth_unavailable",
        "m720q-b": "auth_unavailable"
      },
      "verification": "example_qwen_runtime_check_record"
    },
    "gemini": {
      "hosts": [
        "m4",
        "m720q-b"
      ],
      "binding": "candidate_only",
      "enabled": false,
      "host_status": {
