{
  "schema_version": 1,
  "policy_status": "example_placement_rules",
  "execution_hosts": {
    "bot": {
      "hostname": "host-a",
      "user": "worker-1",
      "allowed_runtimes": [
        "claude",
        "cursor"
      ],
      "verification": "example_host_check_record"
    },
    "m5": {
      "hostname": "host-b",
      "hardware_model": "generic-arm64-workstation",
      "allowed_runtimes": [
        "codex",
        "ollama"
      ],
      "preferred_executor": "executor-1",
      "verification": "example_host_check_record"
    },
    "m4": {
      "hostname": "host-c",
      "user": "worker-2",
      "allowed_runtimes": [
        "ollama",
        "ollama-m4-guarded",
        "qwen",
        "gemini",
        "kimi"
      ],
      "binding": "candidate_only",
      "verification": "example_host_check_record"
    },
    "m720q-b": {
      "hostname": "host-d",
      "user": "worker-3",
      "allowed_runtimes": [
        "qwen",
        "gemini",
        "step",
        "minimax",
        "codebuddy"
      ],
      "binding": "candidate_only",
      "verification": "example_host_check_record"
    },
    "server-01": {
      "hostname": "host-e",
      "user": "worker-4",
      "allowed_runtimes": [
        "cursor"
      ],
      "binding": "candidate_only",
      "verification": "example_host_check_record"
    }
  },
  "runtime_candidates": {
    "cursor": {
      "hosts": [
        "server-01",
        "bot"
      ],
      "binding": "candidate_only",
