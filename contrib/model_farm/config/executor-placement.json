      },
      "verification": "example_gemini_runtime_check_record"
    },
    "kimi": {
      "hosts": [
        "m4"
      ],
      "binding": "candidate_only",
      "enabled": true,
      "host_status": {
        "m4": "verified_ready"
      },
      "verification": "example_kimi_runtime_check_record"
    },
    "step": {
      "hosts": [
        "m720q-b"
      ],
      "binding": "candidate_only",
      "enabled": false,
      "host_status": {
        "m720q-b": "auth_unverified"
      },
      "verification": "example_step_runtime_check_record"
    },
    "minimax": {
      "hosts": [
        "m720q-b"
      ],
      "binding": "candidate_only",
      "enabled": false,
      "host_status": {
        "m720q-b": "auth_unverified"
      },
      "verification": "example_minimax_runtime_check_record"
    },
    "codebuddy": {
      "hosts": [
        "m720q-b"
      ],
      "binding": "candidate_only",
      "enabled": false,
      "host_status": {
        "m720q-b": "auth_unverified"
      },
      "verification": "example_codebuddy_runtime_check_record"
    }
  },
  "memory": {
    "authority_host": "nas",
    "authority_scope": [
      "formal-memory",
      "notes",
      "cited-attachments"
    ],
    "backup_hosts": [
      "index-host"
    ],
    "misc_archive_hosts": [
      "index-host"
    ],
    "backup_verified": false,
    "automatic_promotion": false
  },
  "legacy_worker_pool": {
    "host_binding": "unknown",
    "allowed_unpinned_models": "policy_compatible_unverified",
    "blocked_runtime_families": [
