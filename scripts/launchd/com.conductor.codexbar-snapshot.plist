<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.conductor.codexbar-snapshot</string>
	<key>ProgramArguments</key>
	<array>
		<string>__PYTHON__</string>
		<string>__REPO__/scripts/codexbar_snapshot.py</string>
		<string>--codexbar</string>
		<string>__CODEXBAR__</string>
		<string>--output</string>
		<string>__HOME__/.conductor/usage/codexbar-snapshot.json</string>
	</array>
	<key>StartInterval</key>
	<integer>300</integer>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/conductor-codexbar-snapshot.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/conductor-codexbar-snapshot.log</string>
</dict>
</plist>
